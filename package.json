{
  "name": "atelier-editorial",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Editorial Luxury architecture studio website — Astro + Sanity",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
