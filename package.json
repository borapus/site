    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.0.6",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "tailwindcss": "^4.3.2"
  }
