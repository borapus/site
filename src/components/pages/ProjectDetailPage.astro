---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';
import { type Lang, useTranslations, localizedPath } from '../../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const slugs = (await getProjects(lang)).map(p => p.slug);
---
<BaseLayout lang={lang} title={`${t('detail.label')} — PUS&CO`} description={t('detail.back')} noindex>
  <section class="detail__head u-container"><h1>{t('detail.label')}</h1><p>{t('detail.back')}</p><a href={localizedPath('/projects', lang)}>{t('projects.title')}</a></section>
  <script is:inline define:vars={{ slugs, lang }}>
    const id = new URLSearchParams(location.search).get('id');
    location.replace(id && slugs.includes(id) ? `/${lang}/projects/${id}/` : '/not-found/');
  </script>
</BaseLayout>
