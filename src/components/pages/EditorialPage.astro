---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoImage from '../ui/SeoImage.astro';
import type { EditorialEntry } from '../../lib/editorial';
import { SITE, absolute } from '../../lib/seo';
interface Props { entry: EditorialEntry }
const {entry} = Astro.props;
const c = entry.content;
const url = absolute(`/${c.lang}/${c.kind}/${c.slug}/`);
const section = c.kind === 'guides' ? (c.lang === 'tr' ? 'Rehberler' : 'Guides') : (c.lang === 'tr' ? 'Hizmetler' : 'Services');
const schema = [
  {'@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'PUS&CO',item:absolute(`/${c.lang}/`)},
    {'@type':'ListItem',position:2,name:section,item:absolute(`/${c.lang}/${c.kind}/`)},
    {'@type':'ListItem',position:3,name:c.h1,item:url},
  ]},
  c.kind === 'guides' ? {'@type':'Article',headline:c.h1,description:c.description,url,inLanguage:c.lang,image:absolute(c.image),author:{'@id':`${SITE}/#organization`},publisher:{'@id':`${SITE}/#organization`}}
    : {'@type':'Service',name:c.h1,description:c.description,url,provider:{'@id':`${SITE}/#organization`}},
];
---
<BaseLayout lang={c.lang} title={c.title} description={c.description} image={c.image} schema={schema}>
  <article class="editorial u-container" data-content-id={c.id} data-content-hash={entry.content_hash}>
    <a class="u-label" href={`/${c.lang}/${c.kind}/`}>{section}</a>
    <h1>{c.h1}</h1>
    <p class="editorial__intro">{c.introduction}</p>
    <div class="editorial__image"><SeoImage src={c.image} alt={c.h1} sizes="(min-width: 900px) 70vw, 100vw" /></div>
    {c.sections.map(s => <section><h2>{s.heading}</h2>{s.paragraphs.map(p => <p>{p}</p>)}</section>)}
    <section><h2>{c.lang === 'tr' ? 'İlgili proje örnekleri' : 'Related project examples'}</h2>
      <ul>{c.related_links.map(link => <li><a class="ghost-underline" href={new URL(link.url).pathname}>{link.anchor}</a></li>)}</ul>
    </section>
  </article>
</BaseLayout>
<style>
  .editorial { padding-top: clamp(160px, 22vh, 280px); padding-bottom: var(--section-gap); max-width: 1100px; }
  h1 { font-size: var(--fs-h1); margin-top: 24px; max-width: 22ch; }
  .editorial__intro { margin-top: 36px; font-size: 1.15rem; max-width: 60ch; }
  .editorial__image { margin-block: 48px; }
  .editorial__image :global(img) { width: 100%; height: auto; }
  section { margin-top: 48px; }
  h2 { font-size: var(--fs-h2); margin-bottom: 24px; }
  section p { margin-top: 20px; max-width: 70ch; }
  ul { padding-left: 20px; } li { margin-top: 12px; }
</style>
